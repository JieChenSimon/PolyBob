data/market_cache/

# Vendor response cache — 306MB of raw Yahoo/OKX/SEC/Tencent JSON.
#
# It was tracked, which made every experiment re-run a ~300MB diff and put the
# repository's history at the mercy of whatever the providers happened to return
# that day. It is a *cache*: derivable, replaceable, and not evidence.
#
# What IS evidence stays tracked: data/*_results.json (per-event returns),
# data/promotion_board.json, data/hypothesis_registry.json. Those are small,
# and they are the files the gate reads.
#
# Rebuild with: python scripts/warm_cache.py
data/market_cache/

# Bitemporal store — derived from the providers, rebuilt by warm_cache.py.
# The *evidence* (data/*_results.json + manifests) stays tracked; the store is
# the substrate those results were measured on and is regenerable.
data/store/
data/datasets/

# Local forecasting weights. Model files are reproducible downloads and can be
# hundreds of MB; manifests and benchmark evidence belong in Git, weights do not.
data/models/

# Replay scratch and large local research products.  The reproducible runner,
# compact report, manifest and progress schema belong in Git; detailed replay
# payloads and SQLite/WAL scratch files remain local evidence and must not be
# accidentally staged as a giant commit.
data/.kernel_replay_*/
data/deep_drawdown_kernel_replay.json
data/deep_drawdown_kernel_*replay.json
data/deep_drawdown_kernel_thresholds_*.json
data/deep_drawdown_kernel_progress.json
data/deep_drawdown_kernel_*progress.json
data/simulation_research_matrix_report.json
data/simulation_research_progress.json
data/simulation_research_a_crypto_report.json
data/simulation_research_a_crypto_progress.json
data/drawdown_universe_*replay.json
data/drawdown_universe_*progress.json
# New standalone cross-sectional replays are local evidence.  Keep the
# compact, tracked report and runner; do not stage multi-megabyte per-trade
# payloads produced by each risk-contract comparison.
data/cross_sectional_standalone_*_fixed.json
data/cross_sectional_standalone_*_dd.json
data/cross_sectional_standalone_*_dd_all_local.json
data/insider_kernel_replay_candidate_*.json
output/
