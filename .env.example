# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/polybob
TIMESCALE_URL=postgresql+asyncpg://user:password@localhost:5432/polybob_timeseries

# Redis
REDIS_URL=redis://localhost:6379/0

# Polymarket API
POLYMARKET_API_KEY=
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_CLOB_REST_URL=https://clob.polymarket.com

# Risk Management
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=500
MAX_SLIPPAGE_BPS=40

# Monitoring
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=auto
API_RELOAD=false

# Product operating mode
PRODUCT_MODE=personal_workbench
ENABLE_LAB_AUTO_TRADER=false

# AI
ANTHROPIC_API_KEY=
