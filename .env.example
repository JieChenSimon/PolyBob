# Local service ports
POLYBOB_API_PORT=18000
POLYBOB_DASHBOARD_PORT=13001
POLYBOB_POSTGRES_PORT=15432
POLYBOB_REDIS_PORT=16379
POLYBOB_PROMETHEUS_PORT=19090
POLYBOB_GRAFANA_PORT=13000
NEXT_PUBLIC_API_BASE_URL=http://localhost:18000
POLYBOB_API_BASE_URL=http://localhost:18000

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:15432/polybob
TIMESCALE_URL=postgresql+asyncpg://user:password@localhost:15432/polybob_timeseries

# Redis
REDIS_URL=redis://localhost:16379/0

# Polymarket API
POLYMARKET_API_KEY=
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_CLOB_REST_URL=https://clob.polymarket.com

# Risk Management
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=500
MAX_SLIPPAGE_BPS=40

# Monitoring
PROMETHEUS_PORT=19090
LOG_LEVEL=INFO
LOG_FORMAT=auto
API_RELOAD=false

# Raw order-book capture (disabled by default). When enabled, the database
# prunes rows older than this many days and keeps at most this many rows.
POLYBOB_BOOK_LOG_ENABLED=false
POLYBOB_BOOK_LOG_RETENTION_DAYS=7
POLYBOB_BOOK_LOG_MAX_ROWS=500000

# Product operating mode
PRODUCT_MODE=personal_workbench
ENABLE_LAB_AUTO_TRADER=false
ENABLE_LAB_BACKTEST=false
NEXT_PUBLIC_ENABLE_LAB_BACKTEST=false
ENABLE_LAB_PAIR_FEATURES=false
ENABLE_LAB_ALTCOIN_DISCOVERY=false

# Compute backend
# python is the safe default. Use rust after installing rust/polybob-core with maturin.
# verify runs Rust and Python for parity checks when the Rust extension is available.
POLYBOB_COMPUTE_BACKEND=python
POLYBOB_RUST_FALLBACK_ENABLED=true

# Crypto discovery
# Leave POLYBOB_OUTBOUND_PROXY empty to use HTTPS_PROXY / ALL_PROXY or the
# enabled macOS HTTPS system proxy. Never commit proxy credentials.
POLYBOB_OUTBOUND_PROXY=
BINANCE_ALPHA_API_URL=https://web3.binance.com
BINANCE_FUTURES_API_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_API_URL=wss://ws-fapi.binance.com/ws-fapi/v1
BINANCE_ALPHA_MARKET_API_URL=https://www.binance.com
DEX_SCREENER_API_URL=https://api.dexscreener.com
DISCOVERY_REQUEST_TIMEOUT_SECONDS=10
DISCOVERY_MIN_COVERAGE=0.70
DISCOVERY_MAX_CASHOUT_RISK=45
DISCOVERY_MIN_PUMP_POTENTIAL=70
DISCOVERY_MIN_LIQUIDITY_USD=500000
DISCOVERY_MIN_VOLUME_24H_USD=1000000

# US equity quote provider
# multi queries Nasdaq and every configured keyed provider concurrently.
# Set explicitly to nasdaq, finnhub, or alpaca-iex only for source diagnostics.
POLYBOB_US_EQUITY_QUOTE_PROVIDER=multi
FINNHUB_API_KEY=
# Keep five requests/minute in reserve below Finnhub's documented free-tier ceiling.
POLYBOB_FINNHUB_REQUESTS_PER_MINUTE=55

# Market-news terminal (市场观察 real-time feed). Uses FINNHUB_API_KEY above.
# Disabled automatically when no Finnhub key is set.
MARKET_NEWS_ENABLED=true
MARKET_NEWS_INTERVAL_SECONDS=90
MARKET_NEWS_CATEGORIES=general,crypto,forex
MARKET_NEWS_MAX_ITEMS_PER_CATEGORY=60
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# A-share order-book signal
# The dashboard API requests real five-level A-share depth from Eastmoney fields
# and can use AkShare as a same-source fallback. If real depth is unavailable,
# PolyBob returns unavailable instead of fabricating an order book.
POLYBOB_AKSHARE_PYTHON=python3
POLYBOB_DISABLE_AKSHARE_ORDERBOOK=0

# AI
ANTHROPIC_API_KEY=
